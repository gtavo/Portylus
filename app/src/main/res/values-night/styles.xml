<resources>
    <style name="Theme.Portylus" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:navigationBarColor">@color/portylus_surface</item>
        <item name="android:enforceNavigationBarContrast">true</item>
        <item name="android:colorAccent">@color/portylus_accent</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">@color/portylus_surface</item>
    </style>
</resources>
